{
  "info": {
    "_postman_id": "f16be875-e208-4b68-80b0-d98d8e5dec4a",
    "name": "Usuarios API - Producción",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58854457",
